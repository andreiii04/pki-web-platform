# ============================================================
#  PKI Web Platform — environment variables template
# ------------------------------------------------------------
#  Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#  Never commit `.env`; only `.env.example` is versioned.
#
#  The backend loads `.env` automatically, and Docker Compose
#  reads it via `--env-file .env` (see README).
# ============================================================

# ============================================================
#  Spring Boot profile
# ------------------------------------------------------------
#  Valid values: dev | prod
# ============================================================
SPRING_PROFILES_ACTIVE=dev


# ============================================================
#  PostgreSQL connection
# ------------------------------------------------------------
#  Used both by the backend and by docker/docker-compose.yml.
# ============================================================
POSTGRES_DB=pki_db
POSTGRES_USER=pki_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# ============================================================
#  CA keystore — the Certificate Authority private key
# ------------------------------------------------------------
#  Generated once with scripts/generate-ca.sh.
#  The path is relative to the monorepo root.
#  CA_KEYSTORE_PASSWORD must match the password entered in the script.
# ============================================================
CA_KEYSTORE_PATH=./secrets/ca-keystore.p12
CA_KEYSTORE_PASSWORD=change_me_ca_keystore_password
CA_KEY_ALIAS=pki-root-ca


# ============================================================
#  JWT — JSON Web Token for API authentication
# ------------------------------------------------------------
#  Generate a secure secret (at least 64 bytes, Base64):
#     openssl rand -base64 64 | tr -d '\n'
#
#  Expiration in milliseconds:
#     3600000   =  1 hour
#     86400000  = 24 hours
# ============================================================
JWT_SECRET=change_me_with_openssl_rand_base64_64
JWT_EXPIRATION_MS=3600000


# ============================================================
#  AES master key — encrypts users' private keys before
#  they are stored in the database
# ------------------------------------------------------------
#  Generate an AES-256 key (32 bytes, Base64):
#     openssl rand -base64 32
# ============================================================
AES_MASTER_KEY=change_me_with_openssl_rand_base64_32
